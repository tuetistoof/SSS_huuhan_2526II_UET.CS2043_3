<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox style="-fx-background-color: #ff6f00; -fx-text-fill: white;" spacing="10">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="Mở phiên đấu giá" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Thiết lập thông tin đấu giá cho sản phẩm của bạn" style="-fx-font-size: 12; -fx-text-fill: #e0e0e0;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-padding: 0;">
            <VBox spacing="20" style="-fx-padding: 20;">

                <!-- Item Information (Read-only) -->
                <VBox spacing="8" style="-fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-padding: 15; -fx-border-radius: 5;">
                    <Label text="Thông tin sản phẩm" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #ff6f00;"/>
                    <Separator/>
                    <HBox spacing="20">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Sản phẩm:" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
                            <Label text="[Tên sản phẩm]" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Loại:" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
                            <Label text="[Loại sản phẩm]" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Giá khởi điểm:" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
                            <Label text="[Giá]" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #d32f2f;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Auction Configuration -->
                <VBox spacing="8">
                    <Label text="⚙️ Cấu hình phiên đấu giá" style="-fx-font-size: 14; -fx-font-weight: bold;"/>

                    <!-- Starting Price -->
                    <VBox spacing="8">
                        <Label text="* Giá khởi điểm (VNĐ)" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                        <TextField promptText="Giá khởi điểm (tự động lấy từ sản phẩm)" editable="false" style="-fx-font-size: 12; -fx-padding: 10;">
                            <VBox.margin>
                                <Insets right="20"/>
                            </VBox.margin>
                        </TextField>
                        <Label text="Giá khởi điểm sẽ được sử dụng từ thông tin sản phẩm" style="-fx-font-size: 10; -fx-text-fill: #999;"/>
                    </VBox>

                    <!-- End Time -->
                    <VBox spacing="8">
                        <Label text="* Thời gian kết thúc" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                        <HBox spacing="10">
                            <DatePicker promptText="Chọn ngày" style="-fx-font-size: 12; -fx-padding: 8;" HBox.hgrow="ALWAYS"/>
                            <Spinner min="0" max="23" initialValue="12" style="-fx-font-size: 12; -fx-padding: 8;" prefWidth="60"/>
                            <Label text=":" style="-fx-font-size: 14;"/>
                            <Spinner min="0" max="59" initialValue="0" style="-fx-font-size: 12; -fx-padding: 8;" prefWidth="60"/>
                        </HBox>
                        <Label text="Chọn ngày và giờ kết thúc đấu giá" style="-fx-font-size: 10; -fx-text-fill: #999;"/>
                    </VBox>

                    <!-- Duration Presets -->
                    <VBox spacing="8">
                        <Label text="Hoặc chọn thời lượng nhanh:" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
                        <HBox spacing="10" wrapText="true">
                            <Button text="1 ngày" style="-fx-padding: 6 12; -fx-font-size: 11;"/>
                            <Button text="3 ngày" style="-fx-padding: 6 12; -fx-font-size: 11;"/>
                            <Button text="7 ngày" style="-fx-padding: 6 12; -fx-font-size: 11;"/>
                            <Button text="14 ngày" style="-fx-padding: 6 12; -fx-font-size: 11;"/>
                            <Button text="30 ngày" style="-fx-padding: 6 12; -fx-font-size: 11;"/>
                        </HBox>
                    </VBox>

                </VBox>

                <Separator/>

                <!-- Auction Rules -->
                <VBox spacing="8">
                    <Label text="📋 Quy tắc đấu giá" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                    <VBox spacing="8" style="-fx-padding: 12; -fx-background-color: #f5f5f5; -fx-border-radius: 5;">
                        <HBox spacing="10" alignment="TOP_LEFT">
                            <Label text="✓" style="-fx-font-size: 12; -fx-text-fill: #4CAF50;"/>
                            <Label text="Bước giá tối thiểu: 1% giá khởi điểm (tối thiểu 10.000 VNĐ)" wrapText="true" style="-fx-font-size: 11;"/>
                        </HBox>
                        <HBox spacing="10" alignment="TOP_LEFT">
                            <Label text="✓" style="-fx-font-size: 12; -fx-text-fill: #4CAF50;"/>
                            <Label text="Phí giao dịch: 10% giá bán cuối cùng (nếu có người thắng)" wrapText="true" style="-fx-font-size: 11;"/>
                        </HBox>
                        <HBox spacing="10" alignment="TOP_LEFT">
                            <Label text="✓" style="-fx-font-size: 12; -fx-text-fill: #4CAF50;"/>
                            <Label text="Nếu hết hạn mà chưa có lượt đấu giá, sản phẩm sẽ ở trạng thái EXPIRED" wrapText="true" style="-fx-font-size: 11;"/>
                        </HBox>
                        <HBox spacing="10" alignment="TOP_LEFT">
                            <Label text="✓" style="-fx-font-size: 12; -fx-text-fill: #4CAF50;"/>
                            <Label text="Bạn có thể sửa lại sản phẩm khi ở trạng thái DRAFT hoặc EXPIRED" wrapText="true" style="-fx-font-size: 11;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <Separator/>

                <!-- Description -->
                <VBox spacing="8">
                    <Label text="Mô tả thêm về phiên đấu giá" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                    <TextArea wrapText="true" promptText="(Không bắt buộc) Thêm thông tin về lý do bán, điều kiện..." style="-fx-font-size: 12; -fx-padding: 10;" minHeight="80" VBox.vgrow="ALWAYS">
                        <VBox.margin>
                            <Insets right="20"/>
                        </VBox.margin>
                    </TextArea>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 15 20; -fx-background-color: #f5f5f5; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="❌ Hủy" style="-fx-font-size: 12; -fx-padding: 10 20;"/>
            <Button text="🔨 Mở phiên đấu giá" style="-fx-font-size: 12; -fx-padding: 10 20; -fx-background-color: #ff6f00; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>
</BorderPane>
