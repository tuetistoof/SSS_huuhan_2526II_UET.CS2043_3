<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../css/bidded-auction.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ssscloud.auction.client.controller.BiddedAuctionController">
    <children>
        <VBox spacing="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <!-- ── HEADER CARD ── -->
            <VBox styleClass="bda-header-card">
                <padding><Insets bottom="18" left="20" right="20" top="18" /></padding>
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <children>
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label styleClass="bda-page-title" text="Active Bids" />
                                    <Label fx:id="lblSubtitle" styleClass="bda-page-sub" text="Auctions you are bidding on" />
                                </children>
                            </VBox>
                            <!-- Badge tổng số -->
                            <StackPane styleClass="bda-count-badge">
                                <children>
                                    <Label fx:id="lblTotalCount" styleClass="bda-count-text" text="0" />
                                </children>
                            </StackPane>
                        </children>
                    </HBox>
                </children>
            </VBox>

            <!-- ── CONTENT AREA ── -->
            <VBox spacing="0" styleClass="bda-content-area" VBox.vgrow="ALWAYS">
                <children>

                    <!-- Spinner — hiện khi đang load -->
                    <VBox fx:id="spinnerPane" alignment="CENTER" managed="true" styleClass="bda-empty-state" visible="true" VBox.vgrow="ALWAYS">
                        <padding><Insets bottom="60" top="60" /></padding>
                        <children>
                            <javafx.scene.control.ProgressIndicator prefHeight="48" prefWidth="48" />
                            <Region prefHeight="12" />
                            <Label styleClass="bda-empty-sub" text="Loading..." />
                        </children>
                    </VBox>

                    <!-- Empty state — ẩn khi đang load hoặc có data -->
                    <VBox fx:id="emptyState" alignment="CENTER" managed="false" styleClass="wl-empty-state" visible="false" VBox.vgrow="ALWAYS">
                        <padding><Insets bottom="60" top="60" /></padding>
                        <children>
                            <Label style="-fx-font-size: 48px;" text="🏷️" />
                            <Region prefHeight="12" />
                            <Label styleClass="bda-empty-title" text="No Active Bids" />
                            <Region prefHeight="6" />
                            <Label styleClass="bda-empty-sub" text="Place a bid on an auction to see it here" wrapText="true" />
                        </children>
                    </VBox>

                    <!-- Danh sách rows — hiện khi có data -->
                    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" managed="false" styleClass="wl-scroll" visible="false" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="listContainer" spacing="0" styleClass="bda-list" />
                        </content>
                    </ScrollPane>

                </children>
            </VBox>

        </VBox>
    </children>
</AnchorPane>
