<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="-Infinity" minWidth="-Infinity" stylesheets="@../css/seller-dashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ssscloud.auction.client.controller.DashboardController">
   <children>
      <HBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox spacing="0" styleClass="main-content" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="14" left="14" right="14" top="14" />
               </padding>
               <children>
                  <VBox spacing="10" styleClass="dashboard-card">
                     <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                     </padding>
                     <VBox.margin>
                        <Insets bottom="0" />
                     </VBox.margin>
                     <children>
                        <HBox alignment="CENTER_LEFT" VBox.vgrow="ALWAYS">
                           <children>
                              <Label fx:id="lblPageTitle" styleClass="page-title" text="Dashboard" />
                              <Pane HBox.hgrow="ALWAYS" />
                              <Button onAction="#openCreateDialog" styleClass="btn-primary" text="+ Tạo phiên đấu giá" />
                           </children>
                        </HBox>
                        <HBox spacing="10" VBox.vgrow="ALWAYS">
                           <children>
                              <VBox alignment="TOP_LEFT" spacing="2" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="10" left="12" right="12" top="10" />
                                 </padding>
                                 <children>
                                    <Label fx:id="lblRunning" styleClass="metric-value-dash" text="—" />
                                    <Label styleClass="metric-label" text="Đang chạy" />
                                    <Label fx:id="lblRunningToday" styleClass="metric-sub-green" text="0 hôm nay" />
                                 </children>
                              </VBox>
                              <VBox alignment="TOP_LEFT" spacing="2" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="10" left="12" right="12" top="10" />
                                 </padding>
                                 <children>
                                    <Label fx:id="lblTotal" styleClass="metric-value-green" text="0" />
                                    <Label styleClass="metric-label" text="Tổng phiên" />
                                    <Label styleClass="metric-sub" text="tháng này" />
                                 </children>
                              </VBox>
                              <VBox alignment="TOP_LEFT" spacing="2" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="10" left="12" right="12" top="10" />
                                 </padding>
                                 <children>
                                    <Label fx:id="lblBidCount" styleClass="metric-value-green" text="0" />
                                    <Label styleClass="metric-label" text="Tổng lượt đấu" />
                                    <Label fx:id="lblBidToday" styleClass="metric-sub-green" text="0 hôm nay" />
                                 </children>
                              </VBox>
                              <VBox alignment="TOP_LEFT" spacing="2" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                 <padding>
                                    <Insets bottom="10" left="12" right="12" top="10" />
                                 </padding>
                                 <children>
                                    <Label fx:id="lblRevenue" styleClass="metric-value-dash" text="—" />
                                    <Label styleClass="metric-label" text="Giá trúng cao nhất" />
                                    <Label styleClass="metric-sub" text="phiên gần nhất" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox spacing="0" styleClass="content-area" VBox.vgrow="ALWAYS">
                     <children>
                        <HBox spacing="0" styleClass="tab-bar" VBox.vgrow="NEVER">
                           <padding>
                              <Insets bottom="0" left="4" right="0" top="0" />
                           </padding>
                           <children>
                              <ToggleButton fx:id="tabAll" onAction="#filterAll" selected="true" styleClass="tab-btn" text="Tất cả" />
                              <ToggleButton fx:id="tabRunning" onAction="#filterRunning" styleClass="tab-btn" text="Đang chạy" />
                              <ToggleButton fx:id="tabOpen" onAction="#filterOpen" styleClass="tab-btn" text="Sắp mở" />
                              <ToggleButton fx:id="tabDone" onAction="#filterFinished" styleClass="tab-btn" text="Đã kết thúc" />
                           </children>
                        </HBox>
                        <TableView fx:id="tblAuctions" styleClass="auction-table" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colTitle" minWidth="160.0" prefWidth="240.0" text="Sản phẩm" />
                              <TableColumn fx:id="colCurrentPrice" minWidth="100.0" prefWidth="130.0" text="Giá hiện tại" />
                              <TableColumn fx:id="colBidCount" minWidth="60.0" prefWidth="90.0" text="Lượt bid" />
                              <TableColumn fx:id="colTimeLeft" minWidth="80.0" prefWidth="120.0" text="Còn lại" />
                              <TableColumn fx:id="colStatus" minWidth="90.0" prefWidth="110.0" text="Trạng thái" />
                              <TableColumn fx:id="colActions" minWidth="100.0" prefWidth="130.0" text="Thao tác" />
                           </columns>
                           <placeholder>
                              <Label styleClass="table-placeholder" text="Chưa có phiên đấu giá nào." />
                           </placeholder>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
