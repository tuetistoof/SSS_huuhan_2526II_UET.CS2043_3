<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="-Infinity" minWidth="-Infinity" styleClass="seller-root" stylesheets="@../css/seller-dashboard1.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ssscloud.auction.client.controller.SellerDashboardController">
    <children>

        <!-- ══════════════════════════════════════════
             BODY  (sidebar + main)
        ══════════════════════════════════════════ -->
        <HBox alignment="TOP_LEFT" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
      
                <!-- ── MAIN CONTENT ── -->
                <VBox spacing="14" styleClass="main-content" HBox.hgrow="ALWAYS">
                    <padding>
                  <Insets bottom="14" left="14" right="14" top="14" />
               </padding>
                    <children>
      
                                    <!-- DASHBOARD CARD (hồng #f2a8b0) -->
                        <VBox spacing="10" styleClass="dashboard-card" VBox.vgrow="NEVER">
                            <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                     </padding>
                            <children>
      
                                            <!-- Header: tiêu đề + nút tạo -->
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="lblPageTitle" styleClass="page-title" text="Dashboard" />
                                        <Pane HBox.hgrow="ALWAYS" />
                                        <Button onAction="#openCreateDialog" styleClass="btn-primary" text="+ Tạo phiên đấu giá" />
                                    </children>
                                </HBox>
      
                                            <!-- Metric cards -->
                                <HBox spacing="10">
                                    <children>
      
                                                    <!-- Phiên đang chạy -->
                                        <VBox alignment="TOP_LEFT" spacing="2" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <padding>
                                    <Insets bottom="10" left="12" right="12" top="10" />
                                 </padding>
                                            <children>
                                                <Label fx:id="lblRunningCount" styleClass="metric-value-green" text="0" />
                                                <Label styleClass="metric-label" text="Phiên đang chạy" />
                                                <Label styleClass="metric-sub-green" text="Đang hoạt động" />
                                            </children>
                                        </VBox>
      
                                                    <!-- Phiên đã kết thúc -->
                                        <VBox alignment="TOP_LEFT" spacing="2" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <padding>
                                    <Insets bottom="10" left="12" right="12" top="10" />
                                 </padding>
                                            <children>
                                                <Label fx:id="lblFinishedCount" styleClass="metric-value-red" text="0" />
                                                <Label styleClass="metric-label" text="Phiên đã kết thúc" />
                                                <Label styleClass="metric-sub-red" text="Lưu trữ" />
                                            </children>
                                        </VBox>
      
                                                    <!-- Số dư -->
                                        <VBox alignment="TOP_LEFT" spacing="2" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <padding>
                                    <Insets bottom="10" left="12" right="12" top="10" />
                                 </padding>
                                            <children>
                                                <Label fx:id="lblAccountBalance" styleClass="metric-value-dash" text="00.000đ" />
                                                <Label styleClass="metric-label" text="Số dư tài khoản" />
                                                <Label styleClass="metric-sub" text="Khả dụng" />
                                            </children>
                                        </VBox>
      
                                                    <!-- Số tài khoản ngân hàng -->
                                        <VBox alignment="TOP_LEFT" spacing="2" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <padding>
                                    <Insets bottom="10" left="12" right="12" top="10" />
                                 </padding>
                                            <children>
                                                <Label fx:id="lblBankAccount" styleClass="metric-value-bank" text="—" />
                                                <Label styleClass="metric-label" text="Số tài khoản" />
                                                <Hyperlink onAction="#changeBankAccount" styleClass="metric-action-link" text="Thay đổi STK" />
                                            </children>
                                        </VBox>
      
                                                </children>
                                </HBox>
                            </children>
                        </VBox>
      
                                    <!-- CONTENT AREA: tabs + table -->
                        <VBox spacing="0" styleClass="content-area" VBox.vgrow="ALWAYS">
                            <children>
      
                                            <!-- Tab bar -->
                                <HBox spacing="0" styleClass="tab-bar" VBox.vgrow="NEVER">
                                    <children>
                                        <ToggleButton fx:id="tabAll" onAction="#filterAll" selected="true" styleClass="tab-btn" text="Tất cả" />
                                        <ToggleButton fx:id="tabRunning" onAction="#filterRunning" styleClass="tab-btn" text="Đang chạy" />
                                        <ToggleButton fx:id="tabOpen" onAction="#filterOpen" styleClass="tab-btn" text="Sắp mở" />
                                        <ToggleButton fx:id="tabDone" onAction="#filterFinished" styleClass="tab-btn" text="Đã kết thúc" />
                                    </children>
                                </HBox>
      
                                            <!-- Auction table -->
                                <TableView fx:id="tblAuctions" styleClass="auction-table" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colTitle" minWidth="160.0" prefWidth="240.0" text="Sản phẩm" />
                                        <TableColumn fx:id="colStartingPrice" minWidth="120.0" prefWidth="150.0" text="Giá khởi điểm" />
                                        <TableColumn fx:id="colCurrentPrice" minWidth="100.0" prefWidth="130.0" text="Giá hiện tại" />
                                        <TableColumn fx:id="colBidCount" minWidth="60.0" prefWidth="80.0" text="Lượt bid" />
                                        <TableColumn fx:id="colTimeLeft" minWidth="80.0" prefWidth="100.0" text="Còn lại" />
                                        <TableColumn fx:id="colStatus" minWidth="90.0" prefWidth="110.0" text="Trạng thái" />
                                        <TableColumn fx:id="colActions" minWidth="100.0" prefWidth="120.0" text="Thao tác" />
                                    </columns>
                                    <placeholder>
                                        <Label styleClass="table-placeholder" text="Chưa có phiên đấu giá nào." />
                                    </placeholder>
                                </TableView>
      
                                        </children>
                        </VBox>
      
                    </children>
                </VBox>
            </children>
        </HBox>

    </children>
</AnchorPane>
