<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ssscloud.auction.client.controller.ItemManagementController">

    <!-- TOP: Header -->
    <top>
        <VBox style="-fx-background-color: #f5f5f5; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <!-- Title -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label fx:id="lblSellerName" style="-fx-font-size: 18; -fx-font-weight: bold;" text="Kho hàng của tôi"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnRefresh" text="↻ Làm mới" style="-fx-font-size: 12;"/>
                <Button fx:id="btnCreateItem" text="+ Tạo sản phẩm mới" style="-fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: #4CAF50; -fx-text-fill: white;"/>
            </HBox>

            <!-- Search & Filter -->
            <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                <TextField fx:id="txtSearch" promptText="Tìm kiếm sản phẩm..." HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnSearch" text="🔍 Tìm" style="-fx-padding: 8 15;"/>
                <Label text="Trạng thái:" style="-fx-font-size: 12;"/>
                <ComboBox fx:id="cmbStatus" prefWidth="150" style="-fx-font-size: 12;"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: Main Content -->
    <center>
        <HBox spacing="20" style="-fx-padding: 20;">

            <!-- Left: Table -->
            <VBox HBox.hgrow="ALWAYS" spacing="10">
                <Label text="Danh sách sản phẩm" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                <TableView fx:id="tblItems" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="100"/>
                        <TableColumn fx:id="colName" text="Tên sản phẩm" prefWidth="150"/>
                        <TableColumn fx:id="colType" text="Loại" prefWidth="100"/>
                        <TableColumn fx:id="colPrice" text="Giá" prefWidth="120"/>
                        <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="100"/>
                        <TableColumn fx:id="colActions" text="Hành động" prefWidth="180"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Right: Details -->
            <VBox spacing="15" style="-fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 1; -fx-padding: 20 0 0 20;" prefWidth="350">
                <Label text="Thông tin chi tiết" style="-fx-font-size: 14; -fx-font-weight: bold;"/>

                <!-- Item Details -->
                <VBox spacing="8">
                    <HBox spacing="10">
                        <Label text="Tên:" style="-fx-font-weight: bold; -fx-min-width: 60;"/>
                        <Label fx:id="lblDetailName" text="--" style="-fx-text-fill: #333;"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Loại:" style="-fx-font-weight: bold; -fx-min-width: 60;"/>
                        <Label fx:id="lblDetailType" text="--" style="-fx-text-fill: #333;"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Giá:" style="-fx-font-weight: bold; -fx-min-width: 60;"/>
                        <Label fx:id="lblDetailPrice" text="--" style="-fx-text-fill: #d32f2f; -fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Trạng thái:" style="-fx-font-weight: bold; -fx-min-width: 60;"/>
                        <Label fx:id="lblDetailStatus" text="--" style="-fx-text-fill: #1976d2;"/>
                    </HBox>
                </VBox>

                <Separator/>

                <!-- Description -->
                <Label text="Mô tả:" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="txtDetailDescription" wrapText="true" editable="false" VBox.vgrow="ALWAYS"/>

                <Separator/>

                <!-- Action Buttons -->
                <VBox spacing="8">
                    <Button fx:id="btnStartAuction" text="🔨 Mở đấu giá" style="-fx-font-size: 12; -fx-padding: 10; -fx-background-color: #ff6f00; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="Infinity"/>
                    <Button fx:id="btnEditItem" text="✏️ Sửa sản phẩm" style="-fx-font-size: 12; -fx-padding: 10; -fx-background-color: #1976d2; -fx-text-fill: white;" prefWidth="Infinity"/>
                    <Button fx:id="btnDeleteItem" text="🗑️ Xóa sản phẩm" style="-fx-font-size: 12; -fx-padding: 10; -fx-background-color: #d32f2f; -fx-text-fill: white;" prefWidth="Infinity"/>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
