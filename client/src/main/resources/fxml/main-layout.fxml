<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="main-root" stylesheets="@../css/layout-main.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ssscloud.auction.client.controller.shared.MainLayoutController">
   <children>
      <BorderPane>
          <top>
              <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
               <Button contentDisplay="CENTER" mnemonicParsing="false" onAction="#toggleSidebar" styleClass="circular-menu-btn">
                  <graphic>
                     <ImageView fx:id="iconMenuBurger" fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../images/menu-burger.png" />
                        </image>
                     </ImageView>
                  </graphic>
               </Button>
               <HBox fx:id="hBoxLogo" alignment="CENTER_LEFT" onMouseClicked="#handleNavDashboard">
                  <children>
                     <ImageView fitHeight="50.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../images/Asset%202.png" />
                        </image>
                     </ImageView>
                     <Label alignment="BOTTOM_LEFT" styleClass="app-logo-btn" text="CloudBid" />
                  </children>
               </HBox>
               <Region HBox.hgrow="ALWAYS" />
               <StackPane>
                  <children>
                     <Button fx:id="btnAvailableBalance" mnemonicParsing="false" onAction="#handleAvailableBalance" styleClass="btn-balance">
                        <graphic>
                           <Label fx:id="lblAvailableBalance" mouseTransparent="true" styleClass="header-balance-label" text="Available: --" />
                        </graphic>
                     </Button>
                  </children>
               </StackPane>
               <Button fx:id="btnToggleTheme" mnemonicParsing="false" onAction="#handleToggleTheme" prefHeight="30.0" styleClass="btn-secondary" text="Dark" />
               <Button fx:id="btnDeposit" mnemonicParsing="false" onAction="#handleDeposit" prefHeight="30.0" styleClass="btn-primary" text="Deposit" />
               <StackPane>
                  <children>
                     <Button fx:id="btnBell" mnemonicParsing="false" onAction="#handleBell" styleClass="btn-ghost">
                        <graphic>
                           <ImageView fx:id="iconNotification" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@../images/notification.png" />
                              </image>
                           </ImageView>
                        </graphic>
                     </Button>
                     <Label fx:id="lblBellBadge" mouseTransparent="true" styleClass="notification-badge" />
                  </children>
               </StackPane>
                   <Label fx:id="lblUsername" styleClass="header-username" text="Name" />
              </HBox>
          </top>
      
          <left>
              <VBox fx:id="sidebar" prefWidth="200.0" spacing="5" styleClass="sidebar">
               <Label fx:id="lblOverview" styleClass="sidebar-group-label" text="OVERVIEW" />
               <HBox fx:id="navDashboard" onMouseClicked="#handleNavDashboard" styleClass="sidebar-item">
                  <children>
                     <ImageView fx:id="iconHome" fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../images/home.png" />
                        </image>
                     </ImageView>
                     <Label fx:id="lblSidebarTitleDB" text="Dashboard" />
                  </children>
               </HBox>
               <Label fx:id="lblAuction" styleClass="sidebar-group-label" text="AUCTION" />
               <HBox fx:id="navActiveBids" onMouseClicked="#handleNavActiveBids" styleClass="sidebar-item">
                  <children>
                     <ImageView fx:id="iconActiveBids" fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../images/calendar-gavel-legal.png" />
                        </image>
                     </ImageView>
                     <Label fx:id="lblSidebarTitleAB" text="Active Bids" />
                  </children>
               </HBox>
               <HBox fx:id="navWatchlist" onMouseClicked="#handleNavWatchlist" styleClass="sidebar-item">
                  <children>
                     <ImageView fx:id="iconWatchlist" fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../images/clock.png" />
                        </image>
                     </ImageView>
                     <Label fx:id="lblSidebarTitleW" text="Watchlist" />
                  </children>
               </HBox>
               <HBox fx:id="navWonItems" onMouseClicked="#handleNavWonItems" styleClass="sidebar-item">
                  <children>
                     <ImageView fx:id="iconWonItems" fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../images/trophy.png" />
                        </image>
                     </ImageView>
                     <Label fx:id="lblSidebarTitleWI" text="Won Items" />
                  </children>
               </HBox>
               <HBox fx:id="navNewAuctionRoom" onMouseClicked="#handleNavNewAuctionRoom" styleClass="sidebar-item">
                  <children>
                     <ImageView fx:id="iconNewAuction" fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../images/add.png" />
                        </image>
                     </ImageView>
                     <Label fx:id="lblSidebarTitleNAR" text="New Auction Room" />
                  </children>
               </HBox>
      
                        <Region VBox.vgrow="ALWAYS" />
               <Button fx:id="btnLogOut" maxWidth="Infinity" onAction="#handleLogout" styleClass="btn-logout" text="Log out">
                  <graphic>
                     <ImageView fx:id="iconLogout" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../images/logout.png" />
                        </image>
                     </ImageView>
                  </graphic>
               </Button>
              </VBox>
          </left>
      
         <center>
            <StackPane>
               <children>
                     
                     <ScrollPane fx:id="mainScrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="main-scroll-pane" vbarPolicy="AS_NEEDED">
                        <content>
                           <StackPane fx:id="contentArea" styleClass="content-area" />
                        </content>
                     </ScrollPane>

                     <fx:include fx:id="loading" source="loading.fxml" visible="false" />
                     
               </children>
            </StackPane>
         </center>

         <right>
         </right>

      </BorderPane>
   </children>
</StackPane>
