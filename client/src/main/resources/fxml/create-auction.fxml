<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox
    prefWidth="480.0"
    spacing="0"
    stylesheets="@../css/seller-dashboard.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.ssscloud.auction.client.controller.CreateAuctionController">

    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <!-- ══ HEADER ══ -->
    <Label text="Tạo phiên đấu giá mới" styleClass="page-title"/>
    <Label text="Điền thông tin bên dưới để khởi tạo phiên đấu giá."
           styleClass="form-subtitle" wrapText="true"/>

    <VBox spacing="0">
        <VBox.margin><Insets top="18"/></VBox.margin>

        <!-- ══ FORM GRID ══ -->
        <GridPane hgap="14" vgap="12">

            <columnConstraints>
                <ColumnConstraints minWidth="130" maxWidth="130"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <!-- Tên phiên -->
            <Label text="Tên phiên *" styleClass="form-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtTitle"
                       promptText="VD: Hành tây tươi vừa rẻ vừa ngon"
                       styleClass="form-input"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <!-- Mô tả -->
            <Label text="Mô tả" styleClass="form-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="1"
                   GridPane.valignment="TOP"/>
            <TextArea fx:id="txtDescription"
                      promptText="Mô tả sản phẩm, tình trạng, xuất xứ..."
                      styleClass="form-input"
                      prefRowCount="3" wrapText="true"
                      GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <!-- Giá khởi điểm -->
            <Label text="Giá khởi điểm *" styleClass="form-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtStartingPrice"
                       styleClass="form-input"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <!-- Bước giá tối thiểu -->
            <Label text="Bước giá tối thiểu" styleClass="form-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="txtMinIncrement"
                       styleClass="form-input"
                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <!-- Ngày kết thúc -->
            <Label text="Ngày kết thúc *" styleClass="form-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <DatePicker fx:id="dpEndDate"
                        promptText="dd/mm/yyyy"
                        maxWidth="Infinity"
                        GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <!-- Giờ kết thúc -->
            <Label text="Giờ kết thúc" styleClass="form-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <TextField fx:id="txtEndTime"
                       styleClass="form-input"
                       GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        </GridPane>

        <!-- ══ ERROR LABEL ══ -->
        <Label fx:id="lblError"
               styleClass="form-error"
               wrapText="true"
               visible="false" managed="false">
            <VBox.margin><Insets top="10"/></VBox.margin>
        </Label>

        <!-- ══ ACTION BUTTONS ══ -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <VBox.margin><Insets top="20"/></VBox.margin>
            <Button fx:id="btnCancel"
                    text="Hủy"
                    styleClass="btn-secondary"
                    onAction="#handleCancel"
                    prefWidth="90"/>
            <Button fx:id="btnSubmit"
                    text="Tạo phiên"
                    styleClass="btn-primary"
                    onAction="#handleSubmit"
                    prefWidth="120"/>
        </HBox>

    </VBox>
</VBox>
