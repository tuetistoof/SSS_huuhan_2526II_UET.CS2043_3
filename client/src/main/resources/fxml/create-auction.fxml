<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="600.0" prefWidth="900.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ssscloud.auction.client.controller.CreateAuctionController">

   <children>
      <VBox prefWidth="250.0" spacing="25.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 0 1 0 0;">
         <padding>
            <Insets bottom="30.0" left="20.0" right="20.0" top="40.0" />
         </padding>
         <children>
            <Label text="Create new auction" wrapText="true">
               <font><Font name="System Bold" size="20.0" /></font>
               <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </Label>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <StackPane>
                     <Circle radius="15.0" />
                     <Label text="1" textFill="WHITE"><font><Font name="System Bold" size="12.0" /></font></Label>
                  </StackPane>
                  <Label text="Auction Info">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Label>
               </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <StackPane>
                     <Circle fill="#e9ecef" radius="15.0" />
                     <Label text="2" textFill="#6c757d"><font><Font name="System Bold" size="12.0" /></font></Label>
                  </StackPane>
                  <Label text="Item Info" textFill="#6c757d" />
               </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <StackPane>
                     <Circle fill="#e9ecef" radius="15.0" />
                     <Label text="3" textFill="#6c757d"><font><Font name="System Bold" size="12.0" /></font></Label>
                  </StackPane>
                  <Label text="Pricing &amp; Bidding" textFill="#6c757d" />
               </children>
            </HBox>
         </children>
      </VBox>

      <StackPane HBox.hgrow="ALWAYS">
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
         <children>
            
            <VBox fx:id="step1Form" maxWidth="500.0" spacing="15.0">
               <children>
                  <Label text="Auction Info">
                     <font><Font name="System Bold" size="24.0" /></font>
                     <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                  </Label>
                  
                  <VBox spacing="5.0">
                     <Label text="Auction name:" />
                     <TextField fx:id="txtTitle" prefHeight="35.0" />
                  </VBox>
                  
                  <VBox spacing="5.0">
                     <Label text="Time start:" />
                     <DatePicker fx:id="dpStartDate" maxWidth="Infinity" prefHeight="35.0" />
                  </VBox>
                  
                  <VBox spacing="5.0">
                     <Label text="Auction duration" />
                     <ComboBox fx:id="cbDuration" maxWidth="Infinity" prefHeight="35.0" promptText="Time" />
                  </VBox>
                  
                  <HBox alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS">
                     <VBox.margin><Insets top="20.0" /></VBox.margin>
                     <Button mnemonicParsing="false" onAction="#goToStep2" prefHeight="35.0" prefWidth="120.0" style="; -fx-text-fill: white; -fx-font-weight: bold;" text="Save Info" />
                  </HBox>
               </children>
            </VBox>

            <VBox fx:id="step2Form" maxWidth="500.0" managed="false" spacing="15.0" visible="false">
               <children>
                  <Label text="Item Info">
                     <font><Font name="System Bold" size="24.0" /></font>
                     <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                  </Label>
                  
                  <VBox spacing="5.0">
                     <Label text="Item name:" />
                     <TextField fx:id="txtItemName" prefHeight="35.0" />
                  </VBox>
                  
                  <HBox alignment="BOTTOM_RIGHT" spacing="15.0" VBox.vgrow="ALWAYS">
                     <VBox.margin><Insets top="20.0" /></VBox.margin>
                     <Button mnemonicParsing="false" onAction="#goToStep1" prefHeight="35.0" prefWidth="90.0" text="Back" />
                     <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="120.0" style="; -fx-text-fill: white; -fx-font-weight: bold;" text="Next Step" />
                  </HBox>
               </children>
            </VBox>

         </children>
      </StackPane>
   </children>
</HBox>