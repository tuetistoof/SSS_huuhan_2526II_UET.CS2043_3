<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="980.0" styleClass="adm-root" stylesheets="@../css/admin-dashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ssscloud.auction.client.controller.AdminDashboardController">

    <children>
        <VBox spacing="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <!-- ══ BODY ══ -->
            <VBox spacing="14" styleClass="adm-body" VBox.vgrow="ALWAYS">
                <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
                <children>

                    <!-- ── Metric cards ── -->
                    <HBox spacing="10" VBox.vgrow="NEVER">
                        <children>
                            <VBox alignment="TOP_LEFT" spacing="3" styleClass="adm-metric-card" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="12" left="14" right="14" top="12" /></padding>
                                <children>
                                    <Label fx:id="lblMetricRunning" styleClass="adm-metric-val-blue" text="—" />
                                    <Label styleClass="adm-metric-lbl" text="Total Running Auctions" />
                                </children>
                            </VBox>
                            <VBox alignment="TOP_LEFT" spacing="3" styleClass="adm-metric-card" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="12" left="14" right="14" top="12" /></padding>
                                <children>
                                    <Label fx:id="lblMetricEnded" styleClass="adm-metric-val-red" text="—" />
                                    <Label styleClass="adm-metric-lbl" text="Total Ended Auctions" />
                                </children>
                            </VBox>
                            <VBox alignment="TOP_LEFT" spacing="3" styleClass="adm-metric-card" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="12" left="14" right="14" top="12" /></padding>
                                <children>
                                    <Label fx:id="lblMetricUsers" styleClass="adm-metric-val-green" text="—" />
                                    <Label styleClass="adm-metric-lbl" text="Total users" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- ── Main card ── -->
                    <VBox spacing="0" styleClass="adm-main-card" VBox.vgrow="ALWAYS">
                        <children>

                            <!-- Tab bar -->
                            <HBox spacing="0" styleClass="adm-tab-bar" VBox.vgrow="NEVER">
                                <padding><Insets left="4" /></padding>
                                <children>
                                    <ToggleButton fx:id="tabAuction" onAction="#switchToAuctions" selected="true" styleClass="adm-tab-btn" text="Auctions" />
                                    <ToggleButton fx:id="tabUser" onAction="#switchToUsers" styleClass="adm-tab-btn" text="Users" />
                                </children>
                            </HBox>

                            <!-- ════ PANEL: Phiên đấu giá ════ -->
                            <VBox fx:id="panelAuctions" spacing="0" VBox.vgrow="ALWAYS">
                                <children>

                                    <!-- Toolbar -->
                                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="adm-toolbar" VBox.vgrow="NEVER">
                                        <padding><Insets bottom="10" left="12" right="12" top="10" /></padding>
                                        <children>
                                            <ToggleButton fx:id="aFilterAll" onAction="#filterAuctionAll" selected="true" styleClass="adm-filter-btn" text="All" />
                                            <ToggleButton fx:id="aFilterRunning" onAction="#filterAuctionRunning" styleClass="adm-filter-btn" text="Running" />
                                            <ToggleButton fx:id="aFilterOpen" onAction="#filterAuctionOpen" styleClass="adm-filter-btn" text="Open" />
                                            <ToggleButton fx:id="aFilterDone" onAction="#filterAuctionDone" styleClass="adm-filter-btn" text="Finished" />
                                            <Region HBox.hgrow="ALWAYS" />
                                        </children>
                                    </HBox>

                                    <!-- Auction table -->
                                    <TableView fx:id="tblAuctions" styleClass="adm-table" VBox.vgrow="ALWAYS">
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                        <columns>
                                            <TableColumn fx:id="aColName" minWidth="180" prefWidth="260" text="Auction name" />
                                            <TableColumn fx:id="aColSeller" minWidth="100" prefWidth="130" text="Seller" />
                                            <TableColumn fx:id="aColPrice" minWidth="110" prefWidth="140" text="Current Price" />
                                            <TableColumn fx:id="aColStatus" minWidth="90" prefWidth="110" text="Status" />
                                            <TableColumn fx:id="aColEnd" minWidth="120" prefWidth="150" text="End Time" />
                                            <TableColumn fx:id="aColAction" minWidth="90" prefWidth="110" text="Operation" />
                                        </columns>
                                        <placeholder>
                                            <Label styleClass="adm-table-placeholder" text="No auction yet." />
                                        </placeholder>
                                    </TableView>

                                </children>
                            </VBox>

                            <!-- ════ PANEL: Người dùng ════ -->
                            <VBox fx:id="panelUsers" managed="false" spacing="0" visible="false" VBox.vgrow="ALWAYS">
                                <children>

                                    <!-- Toolbar -->
                                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="adm-toolbar" VBox.vgrow="NEVER">
                                        <padding><Insets bottom="10" left="12" right="12" top="10" /></padding>
                                        <children>
                                            <ToggleButton fx:id="uFilterAll" onAction="#filterUserAll" selected="true" styleClass="adm-filter-btn" text="All" />
                                            <ToggleButton fx:id="uFilterSeller" onAction="#filterUserSeller" styleClass="adm-filter-btn" text="Seller" />
                                            <ToggleButton fx:id="uFilterBidder" onAction="#filterUserBidder" styleClass="adm-filter-btn" text="Bidder" />
                                            <Region HBox.hgrow="ALWAYS" />
                                        </children>
                                    </HBox>
                                    
                                    <!-- User table -->
                                    <TableView fx:id="tblUsers" styleClass="adm-table" VBox.vgrow="ALWAYS">
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                        <columns>
                                            <TableColumn fx:id="uColUsername" minWidth="120" prefWidth="160" text="Username" />
                                            <TableColumn fx:id="uColEmail" minWidth="160" prefWidth="220" text="Email" />
                                            <TableColumn fx:id="uColRole" minWidth="80" prefWidth="100" text="Role" />
                                            <TableColumn fx:id="uColAccountBalance" minWidth="100" prefWidth="130" text="Account Balance" />
                                        </columns>
                                        <placeholder>
                                            <Label styleClass="adm-table-placeholder" text="No user yet." />
                                        </placeholder>
                                    </TableView>

                                </children>
                            </VBox>

                        </children>
                    </VBox>

                </children>
            </VBox>

        </VBox>
    </children>
</AnchorPane>
