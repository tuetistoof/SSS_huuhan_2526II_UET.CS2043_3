<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="auctionCard" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="280.0" styleClass="main-card" stylesheets="@../css/component-auction-card.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ssscloud.auction.client.controller.bidder.AuctionCardController">
   <children>
      <StackPane fx:id="imgItem" prefHeight="220.0" prefWidth="280.0" styleClass="card-image-container" />
      
      <VBox spacing="8.0">
         <children>
            <Label fx:id="lblItemName" prefWidth="250.0" styleClass="card-item-name" text="Auction + Item name" wrapText="true" />
            
            <Label fx:id="lblCurrentPrice" styleClass="card-current-price" text="Current Price" />
            
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Label text="⏳" />
                  <Label fx:id="lblEndTime" styleClass="card-end-time" text="Endtime" />
               </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Label styleClass="card-icon-seller" text="👤" />
                  <Label fx:id="lblSellerUsername" styleClass="card-seller-name" text="Seller username" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="12.0" />
         </padding>
      </VBox>
   </children>
</VBox>