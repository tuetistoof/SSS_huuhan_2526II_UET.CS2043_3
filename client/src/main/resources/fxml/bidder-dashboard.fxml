<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="-Infinity" minWidth="-Infinity" styleClass="bdd-root" stylesheets="@../css/screen-seller-dashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ssscloud.auction.client.controller.bidder.BidderDashboardController">
   <children>
      <HBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox spacing="0" styleClass="main-content" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="14" left="14" right="14" top="14" />
               </padding>
               <children>
                  
                  <StackPane fx:id="bannerContainer" prefHeight="400.0" style="-fx-background-radius: 12px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 4); -fx-background-color: #25252A;">
                     <VBox.margin>
                        <Insets bottom="14.0" />
                     </VBox.margin>
                     <children>
                        
                        <Pane fx:id="bannerPane" prefHeight="400.0" style="-fx-background-radius: 12px;" />
                        
                        <AnchorPane>
                           <children>
                              <Button onAction="#handlePrevBanner" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-cursor: hand;" text="❮" AnchorPane.leftAnchor="15.0" AnchorPane.topAnchor="200.0" />
                              <Button onAction="#handleNextBanner" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-cursor: hand;" text="❯" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="200.0" />
                           </children>
                        </AnchorPane>
                     </children>
                  </StackPane>

                  <VBox spacing="0" styleClass="content-area" VBox.vgrow="ALWAYS">
                     <children>
                        <HBox spacing="0" styleClass="tab-bar" VBox.vgrow="NEVER">
                           <padding>
                              <Insets bottom="0" left="4" right="0" top="0" />
                           </padding>
                           <children>
                              <ToggleButton fx:id="tabAll" onAction="#filterAll" selected="true" styleClass="tab-btn" text="Tất cả" />
                              <ToggleButton fx:id="tabElectronics" onAction="#filterElectronics" styleClass="tab-btn" text="Đồ điện tử" />
                              <ToggleButton fx:id="tabArts" onAction="#filterArts" styleClass="tab-btn" text="Tác phẩm nghệ thuật" />
                              <ToggleButton fx:id="tabVehicles" onAction="#filterVehicles" styleClass="tab-btn" text="Xe cộ" />
                           </children>
                        </HBox>
                        <Region prefHeight="10.0" />
                        <FlowPane fx:id="auctionContainer" hgap="16.0" vgap="16.0">
                           <padding>
                              <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                           </padding>
                        </FlowPane>
                     </children>
                  </VBox>
                  
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>