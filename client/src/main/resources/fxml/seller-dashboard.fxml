<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="-Infinity" minWidth="-Infinity" styleClass="seller-root" stylesheets="@../css/screen-seller-dashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ssscloud.auction.client.controller.seller.SellerDashboardController">
    <children>

        <!-- ══════════════════════════════════════════
             BODY  (sidebar + main)
        ══════════════════════════════════════════ -->
        <HBox alignment="TOP_LEFT" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
      
                <!-- ── MAIN CONTENT ── -->
                <VBox spacing="14" styleClass="main-content" HBox.hgrow="ALWAYS">
                    <padding>
                  <Insets bottom="14" left="14" right="14" top="14" />
               </padding>
                    <children>
      
                                    <!-- DASHBOARD -->
                        <VBox spacing="10" styleClass="dashboard-card" VBox.vgrow="NEVER">
                            <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                     </padding>
                            <children>
      
                                            <!-- Header:title + btn create-->
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="lblPageTitle" styleClass="page-title" text="Dashboard" />
                                        <Pane HBox.hgrow="ALWAYS" />
                                        <Button onAction="#openCreateDialog" styleClass="btn-primary" text="+ Create a new auction" />
                                    </children>
                                </HBox>
      
                                            <!-- Metric cards -->
                                <HBox spacing="10">
                                    <children>
      
                                                    <!-- Metric 1: running-->
                                        <VBox alignment="TOP_LEFT" spacing="2" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <padding>
                                    <Insets bottom="10" left="12" right="12" top="10" />
                                 </padding>
                                            <children>
                                                <Label fx:id="lblRunningCount" styleClass="metric-value-green" text="0" />
                                                <Label styleClass="metric-label" text="Total running auctions" />
                                                <Label styleClass="metric-sub-green" text="Running" />
                                            </children>
                                        </VBox>
      
                                                    <!-- Metric 2: ended auctions -->
                                        <VBox alignment="TOP_LEFT" spacing="2" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <padding>
                                    <Insets bottom="10" left="12" right="12" top="10" />
                                 </padding>
                                            <children>
                                                <Label fx:id="lblFinishedCount" styleClass="metric-value-red" text="0" />
                                                <Label styleClass="metric-label" text="Total finished auctions" />
                                                <Label styleClass="metric-sub-red" text="Ended" />
                                            </children>
                                        </VBox>
      
                                                    <!-- Metric 3: balance  -->
                                        <VBox alignment="TOP_LEFT" spacing="2" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <padding>
                                    <Insets bottom="10" left="12" right="12" top="10" />
                                 </padding>
                                            <children>
                                                <Label fx:id="lblAccountBalance" styleClass="metric-value-dash" text="00.000đ" />
                                                <Label styleClass="metric-label" text="Account balance" />
                                                <Label styleClass="metric-sub" text="Available" />
                                            </children>
                                        </VBox>
      
                                                    <!-- Số tài khoản ngân hàng -->
                                        <VBox alignment="TOP_LEFT" spacing="2" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                            <padding>
                                    <Insets bottom="10" left="12" right="12" top="10" />
                                 </padding>
                                            <children>
                                                <Label fx:id="lblBankAccount" styleClass="metric-value-bank" text="—" />
                                                <Label styleClass="metric-label" text="Bank number" />
                                                <Hyperlink onAction="#changeBankAccount" styleClass="metric-action-link" text="Change your bank account" />
                                            </children>
                                        </VBox>
      
                                                </children>
                                </HBox>
                            </children>
                        </VBox>
      
                                    <!-- CONTENT AREA: tabs + table -->
                        <VBox spacing="0" styleClass="content-area" VBox.vgrow="ALWAYS">
                            <children>
      
                                            <!-- Tab bar -->
                                <HBox spacing="0" styleClass="tab-bar" VBox.vgrow="NEVER">
                                    <children>
                                        <ToggleButton fx:id="tabAll" onAction="#filterAll" selected="true" styleClass="tab-btn" text="All" />
                                        <ToggleButton fx:id="tabRunning" onAction="#filterRunning" styleClass="tab-btn" text="Running" />
                                        <ToggleButton fx:id="tabOpen" onAction="#filterOpen" styleClass="tab-btn" text="Upcoming" />
                                        <ToggleButton fx:id="tabDone" onAction="#filterFinished" styleClass="tab-btn" text="Finished" />
                                    </children>
                                </HBox>
      
                                            <!-- Auction table -->
                                <TableView fx:id="tblAuctions" styleClass="auction-table" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    
                                    <columns>
                                        <TableColumn fx:id="colTitle" prefWidth="250.0" text="Item" />
                                        <TableColumn fx:id="colStartingPrice" prefWidth="150.0" text="Starting price" />
                                        <TableColumn fx:id="colCurrentPrice" prefWidth="150.0" text="Current price" />
                                        <TableColumn fx:id="colBidCount" prefWidth="80.0" text="Bid count" />
                                        <TableColumn fx:id="colTimeLeft" prefWidth="100.0" text="Remaining time" />
                                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                                        <TableColumn fx:id="colActions" prefWidth="140.0" text="View" />
                                    </columns>
                                    <placeholder>
                                        <Label styleClass="table-placeholder" text="There is no auction! Try create a new one" />
                                    </placeholder>
                                </TableView>
      
                            </children>
                        </VBox>
      
                    </children>
                </VBox>
            </children>
        </HBox>

    </children>
</AnchorPane>
