<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane
    prefWidth="1024.0"
    prefHeight="680.0"
    styleClass="seller-root"
    stylesheets="@../css/seller-dashboard.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.ssscloud.auction.client.controller.SellerDashboardController">

    <!-- ══ TOPBAR ══ -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="6">
            <padding><Insets top="0" right="20" bottom="0" left="20"/></padding>
            <Label text="CloudBid" styleClass="topbar-brand-bold"/>
            <Label text="Seller Center" styleClass="topbar-brand-light"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblShopName" text="Shop: —" styleClass="topbar-shop"/>
            <Label fx:id="lblAvatar" text="??" styleClass="avatar-circle"/>
        </HBox>
    </top>

    <!-- ══ SIDEBAR + MAIN ══ -->
    <center>
        <HBox>

            <!-- ── SIDEBAR ── -->
            <VBox styleClass="sidebar" minWidth="160" maxWidth="160" prefWidth="160">
                <padding><Insets top="12" right="0" bottom="12" left="0"/></padding>

                <Label text="Tổng quan" styleClass="nav-section"/>
                <Button fx:id="btnDashboard" text="Dashboard" styleClass="nav-active"
                        maxWidth="Infinity" onAction="#showDashboard"/>

                <Label text="Đấu giá" styleClass="nav-section"/>
                <Button fx:id="btnMyAuctions" text="Phiên của tôi" styleClass="nav-item"
                        maxWidth="Infinity" onAction="#showMyAuctions"/>
                <Button fx:id="btnHistory" text="Lịch sử" styleClass="nav-item"
                        maxWidth="Infinity" onAction="#showHistory"/>

                <Label text="Sản phẩm" styleClass="nav-section"/>
                <Button fx:id="btnCreate" text="+ Tạo phiên mới" styleClass="nav-item"
                        maxWidth="Infinity" onAction="#openCreateDialog"/>
                <Button fx:id="btnInventory" text="Kho sản phẩm" styleClass="nav-item"
                        maxWidth="Infinity" onAction="#showInventory"/>

                <Label text="Tài khoản" styleClass="nav-section"/>
                <Button fx:id="btnProfile" text="Hồ sơ shop" styleClass="nav-item"
                        maxWidth="Infinity" onAction="#showProfile"/>

                <Pane VBox.vgrow="ALWAYS"/>

                <Button text="Đăng xuất" styleClass="nav-logout"
                        maxWidth="Infinity" onAction="#handleLogout">
                    <VBox.margin><Insets top="0" right="14" bottom="0" left="14"/></VBox.margin>
                </Button>
            </VBox>

            <!-- ── MAIN CONTENT ── -->
            <VBox styleClass="main-content" HBox.hgrow="ALWAYS" spacing="0">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

                <!-- ═══ PINK DASHBOARD CARD ═══ -->
                <VBox styleClass="dashboard-card" spacing="10">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <VBox.margin><Insets bottom="0"/></VBox.margin>

                    <!-- Header: title + button -->
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="lblPageTitle" text="Dashboard" styleClass="page-title"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Button text="+ Tạo phiên đấu giá" styleClass="btn-primary"
                                onAction="#openCreateDialog"/>
                    </HBox>

                    <!-- 4 metric cards – maxHeight cố định để không tràn -->
                    <HBox spacing="10">
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"
                              maxHeight="80" minHeight="80" spacing="2" alignment="TOP_LEFT">
                            <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                            <Label fx:id="lblRunning" text="—" styleClass="metric-value-dash"/>
                            <Label text="Đang chạy" styleClass="metric-label"/>
                            <Label fx:id="lblRunningToday" text="0 hôm nay" styleClass="metric-sub-green"/>
                        </VBox>
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"
                              maxHeight="80" minHeight="80" spacing="2" alignment="TOP_LEFT">
                            <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                            <Label fx:id="lblTotal" text="0" styleClass="metric-value-green"/>
                            <Label text="Tổng phiên" styleClass="metric-label"/>
                            <Label text="tháng này" styleClass="metric-sub"/>
                        </VBox>
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"
                              maxHeight="80" minHeight="80" spacing="2" alignment="TOP_LEFT">
                            <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                            <Label fx:id="lblBidCount" text="0" styleClass="metric-value-green"/>
                            <Label text="Tổng lượt đấu" styleClass="metric-label"/>
                            <Label fx:id="lblBidToday" text="0 hôm nay" styleClass="metric-sub-green"/>
                        </VBox>
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"
                              maxHeight="80" minHeight="80" spacing="2" alignment="TOP_LEFT">
                            <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                            <Label fx:id="lblRevenue" text="—" styleClass="metric-value-dash"/>
                            <Label text="Giá trúng cao nhất" styleClass="metric-label"/>
                            <Label text="phiên gần nhất" styleClass="metric-sub"/>
                        </VBox>
                    </HBox>

                </VBox>
                <!-- ═══ END PINK CARD ═══ -->

                <!-- ═══ WHITE CONTENT AREA ═══ -->
                <VBox styleClass="content-area" VBox.vgrow="ALWAYS" spacing="0">

                    <!-- Tab bar -->
                    <HBox styleClass="tab-bar" spacing="0">
                        <padding><Insets top="0" right="0" bottom="0" left="4"/></padding>
                        <ToggleButton fx:id="tabAll"     text="Tất cả"
                                      styleClass="tab-btn" selected="true" onAction="#filterAll"/>
                        <ToggleButton fx:id="tabRunning" text="Đang chạy"
                                      styleClass="tab-btn" onAction="#filterRunning"/>
                        <ToggleButton fx:id="tabOpen"    text="Sắp mở"
                                      styleClass="tab-btn" onAction="#filterOpen"/>
                        <ToggleButton fx:id="tabDone"    text="Đã kết thúc"
                                      styleClass="tab-btn" onAction="#filterFinished"/>
                    </HBox>

                    <!-- Table -->
                    <TableView fx:id="tblAuctions" VBox.vgrow="ALWAYS" styleClass="auction-table">
                        <columns>
                            <TableColumn fx:id="colTitle"        text="Sản phẩm"     prefWidth="240" minWidth="160"/>
                            <TableColumn fx:id="colCurrentPrice" text="Giá hiện tại" prefWidth="130" minWidth="100"/>
                            <TableColumn fx:id="colBidCount"     text="Lượt bid"     prefWidth="90"  minWidth="60"/>
                            <TableColumn fx:id="colTimeLeft"     text="Còn lại"      prefWidth="120" minWidth="80"/>
                            <TableColumn fx:id="colStatus"       text="Trạng thái"   prefWidth="110" minWidth="90"/>
                            <TableColumn fx:id="colActions"      text="Thao tác"     prefWidth="130" minWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="Chưa có phiên đấu giá nào." styleClass="table-placeholder"/>
                        </placeholder>
                    </TableView>

                </VBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>
