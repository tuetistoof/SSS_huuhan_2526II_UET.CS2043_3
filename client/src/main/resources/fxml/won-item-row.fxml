<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="rowRoot"
      alignment="CENTER_LEFT"
      spacing="16"
      styleClass="wi-row"
      stylesheets="@/css/screen-won-items.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ssscloud.auction.client.controller.bidder.ItemsWonRowController">
    <padding><Insets bottom="12" left="16" right="16" top="12" /></padding>
    <children>

        <!-- Thumbnail -->
        <StackPane fx:id="imgThumb"
                   maxHeight="72" maxWidth="72"
                   minHeight="72" minWidth="72"
                   styleClass="wi-thumb" />

        <!-- Thông tin auction -->
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="lblAuctionName"
                       maxWidth="340"
                       styleClass="wi-row-title"
                       text="Auction name"
                       wrapText="false" />
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <children>
                        <Label fx:id="lblItemType" styleClass="wi-badge-type" text="Item Type" />
                        <Label fx:id="lblSeller"   styleClass="wi-row-seller" text="Seller name" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <children>
                        <Label fx:id="lblWinningPrice" styleClass="wi-row-price" text="Winning price" />
                        <Label fx:id="lblWonDate"      styleClass="wi-row-date"  text="Won date" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Action -->
        <VBox alignment="CENTER">
            <children>
                <Button fx:id="btnView"
                        onAction="#handleViewDetails"
                        prefWidth="90.0"
                        styleClass="wi-btn-view"
                        text="Details" />
            </children>
        </VBox>

    </children>
</HBox>
